NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Fase 7 -- Notifikasi
# Service role key (Supabase Dashboard > Project Settings > API) -- HANYA
# dipakai server-side oleh cron reminder (lib/supabase/admin.ts), jangan
# pernah pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# API key dari resend.com -- dipakai untuk kirim semua email notifikasi.
RESEND_API_KEY=your-resend-api-key
# Alamat pengirim. Kalau domain kustom belum diverifikasi di Resend, boleh
# dikosongkan -- kode fallback ke "PanitiYAY <onboarding@resend.dev>".
EMAIL_FROM=PanitiYAY <notifikasi@yourdomain.com>
# String rahasia bebas -- isi juga persis nilai yang sama di Vercel Project
# Settings > Environment Variables, supaya Vercel Cron otomatis mengirim
# header "Authorization: Bearer <CRON_SECRET>" saat memanggil endpoint cron.
CRON_SECRET=your-random-secret
